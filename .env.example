# ==========================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_seguro
DB_NAME=tu_base_de_datos

# ==========================
# CONFIGURACIÓN DE SEGURIDAD
# ==========================
# IMPORTANTE: Cambiar a un secreto seguro en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_secreto_jwt_super_seguro_cambiar_en_produccion

# ==========================
# CONFIGURACIÓN DE ENTORNO
# ==========================
NODE_ENV=development # production | development | test
PORT=3000

# ==========================
# ROLES Y PRIVILEGIOS — FASE 3 (enforcement)
# ==========================
# simular (default si se omite) = nunca bloquea, solo registra en consola lo
#   que HABRÍA bloqueado. Usar mientras se completa la asignación de
#   privilegios a usuarios reales, antes de activar el candado de verdad.
# bloquear = comportamiento real (403 si falta el privilegio).
# Ver GrupEB_Frontend/docs/roles-privilegios-plan.md §5.1.
PERMISOS_MODO=simular

# ==========================
# CONFIGURACIÓN DE CORS
# ==========================
FRONTEND_URL=http://localhost:5173

# ==========================
# CONFIGURACIÓN DE COOKIES (OPCIONAL)
# ==========================
# COOKIE_DOMAIN=.tudominio.com # Descomentar si usas subdominios

# ==========================
# CONFIGURACIÓN DE LOGS (OPCIONAL)
# ==========================
LOG_LEVEL=info # error | warn | info | debug

# ==========================
# TIPO DE CAMBIO (Banxico SIE API)
# ==========================
# Token gratuito: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=tu_token_banxico

# ==========================
# NOTIFICACIONES PUSH (VAPID)
# ==========================
# Generar con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=tu_vapid_public_key
VAPID_PRIVATE_KEY=tu_vapid_private_key
VAPID_SUBJECT=mailto:contacto@tudominio.com
